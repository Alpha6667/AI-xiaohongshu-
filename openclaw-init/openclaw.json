{
  "name": "",
  "version": "",
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN_HERE"
    }
  },
  "channels": {},
  "plugins": {
    "entries": {
      "bonjour": { "enabled": false, "storage": "local" },
      "duckduckgo": { "enabled": true, "storage": "local" },
      "ddingtalk": { "enabled": false, "storage": "local" },
      "lightclawbot": { "enabled": false, "storage": "local" },
      "wecom": { "enabled": false, "storage": "local" },
      "openclaw-weixin": { "enabled": false, "storage": "local" },
      "openclaw-plugin-yuanbao": { "enabled": true }
    }
  },
  "skills": {
    "presets": {
      "weather": { "enabled": true },
      "video-frames": { "enabled": true },
      "docx": { "enabled": true },
      "taskflow": { "enabled": true },
      "healthcheck": { "enabled": true },
      "node-connect": { "enabled": true },
      "gh-issues": { "enabled": true },
      "github": { "enabled": true },
      "skill-creator": { "enabled": true },
      "clawhub": { "enabled": true },
      "find-skills": { "enabled": true },
      "skillhub-preference": { "enabled": true },
      "browser-automation": { "enabled": true },
      "token-saver": { "enabled": true },
      "acp-router": { "enabled": true },
      "qqbot-channel": { "enabled": false },
      "qqbot-media": { "enabled": false },
      "qqbot-remind": { "enabled": false }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "api": "openai-completions",
        "apiKey": "YOUR_DEEPSEEK_API_KEY",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 65536,
            "maxTokens": 8192,
            "cost": { "input": 0.0005, "output": 0.0015 },
            "costUnit": "kTokens"
          }
        ]
      },
      "jdcloud": {
        "baseUrl": "https://wukong-api.jd.com/v1",
        "api": "openai-completions",
        "apiKey": "YOUR_JDCLOUD_API_KEY",
        "models": [
          {
            "id": "GLM-5",
            "name": "京东云 GLM-5",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 16384,
            "cost": { "input": 0, "output": 0 },
            "costUnit": "kTokens"
          },
          {
            "id": "DeepSeek-V3.2",
            "name": "京东云 DeepSeek-V3.2",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 65536,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0 },
            "costUnit": "kTokens"
          }
        ]
      }
    }
  },
  "agents": {
    "default": {
      "model": "jdcloud/GLM-5"
    }
  },
  "identity": {
    "name": "沛虾",
    "creature": "一只被亲手安装的龙虾 AI",
    "vibe": "对大哥忠诚，办事靠谱，偶尔皮一下",
    "emoji": "🦞"
  }
}
